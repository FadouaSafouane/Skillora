"""Tableau de bord administrateur de Skillora."""



from tkinter import ttk, messagebox
import customtkinter as ctk
from database import db
 
ctk.set_appearance_mode("System")
ctk.set_default_color_theme("blue")
 
NAV = ["Dashboard", "Members", "Formations", "Statistics"]
KPIS = [("Membres Totaux", "0"), ("Membres Actifs", "0"), ("Formations", "14"),
        ("Inscriptions", "142"), ("Taux Réussite", "78%")]
COLS = [("ID", "ID", 50, "center"), ("Nom", "Nom complet", 200, "w"),
        ("Email", "Adresse Email", 250, "w"), ("Statut", "Statut", 100, "center")]
 
 
class AdminDashboard(ctk.CTk):
    def __init__(self, admin="Admin"):
        super().__init__()
        self.admin, self.logged_out = admin, False
        self.title("Skillora - Admin Dashboard")
        self.geometry("1100x650")
        self.minsize(1000, 600)
        self.grid_columnconfigure(1, weight=1)
        self.grid_rowconfigure(0, weight=1)
        self.build_sidebar()
        self.build_main()
        self.show_page("Members")
        self.refresh()
 
    def build_sidebar(self):
        sb = ctk.CTkFrame(self, width=200, corner_radius=0)
        sb.grid(row=0, column=0, sticky="nsew")
        sb.grid_rowconfigure(6, weight=1)
        ctk.CTkLabel(sb, text="SKILLORA", font=ctk.CTkFont(size=22, weight="bold")).grid(
            row=0, column=0, padx=20, pady=(20, 5))
        ctk.CTkLabel(sb, text=self.admin, text_color="gray").grid(row=1, column=0, pady=(0, 15))
        self.nav = {}
        for row, name in enumerate(NAV, start=2):
            self.nav[name] = ctk.CTkButton(
                sb, text=name, fg_color="transparent", text_color=("gray10", "gray90"),
                hover_color=("gray75", "gray25"), anchor="w", command=lambda n=name: self.show_page(n))
            self.nav[name].grid(row=row, column=0, padx=20, pady=10, sticky="ew")
        ctk.CTkButton(sb, text="Logout", fg_color="#d9534f", hover_color="#c9302c",
                      command=self.logout).grid(row=7, column=0, padx=20, pady=20, sticky="ew")
 
    def build_main(self):
        main = ctk.CTkFrame(self, fg_color="transparent")
        main.grid(row=0, column=1, padx=20, pady=20, sticky="nsew")
        main.grid_columnconfigure(0, weight=1)
        main.grid_rowconfigure(1, weight=1)
 
        # Cartes de statistiques
        stats = ctk.CTkFrame(main, fg_color="transparent")
        stats.grid(row=0, column=0, sticky="ew", pady=(0, 20))
        self.kpi = []
        for i, (title, value) in enumerate(KPIS):
            stats.grid_columnconfigure(i, weight=1)
            card = ctk.CTkFrame(stats, height=80)
            card.grid(row=0, column=i, sticky="ew", padx=5)
            ctk.CTkLabel(card, text=title, font=ctk.CTkFont(size=11, weight="bold"),
                         text_color="gray").pack(pady=(10, 0), padx=10)
            lbl = ctk.CTkLabel(card, text=value, font=ctk.CTkFont(size=20, weight="bold"))
            lbl.pack(pady=(0, 10), padx=10)
            self.kpi.append(lbl)
 
        # Pages
        box = ctk.CTkFrame(main, fg_color="transparent")
        box.grid(row=1, column=0, sticky="nsew")
        box.grid_columnconfigure(0, weight=1)
        box.grid_rowconfigure(0, weight=1)
        self.members_page = ctk.CTkFrame(box, fg_color="transparent")
        self.other_page = ctk.CTkFrame(box)
        for p in (self.members_page, self.other_page):
            p.grid(row=0, column=0, sticky="nsew")
        self.other_label = ctk.CTkLabel(self.other_page, text="", font=ctk.CTkFont(size=18))
        self.other_label.place(relx=0.5, rely=0.5, anchor="center")
        self.build_members_page()
 
    def build_members_page(self):
        page = self.members_page
        page.grid_columnconfigure(0, weight=1)
        page.grid_rowconfigure(1, weight=1)
 
        # Recherche + actions
        bar = ctk.CTkFrame(page, fg_color="transparent")
        bar.grid(row=0, column=0, sticky="ew", pady=(0, 10))
        bar.grid_columnconfigure(0, weight=1)
        self.search = ctk.CTkEntry(bar, placeholder_text="Rechercher un membre par nom...")
        self.search.grid(row=0, column=0, sticky="ew", padx=(0, 10))
        self.search.bind("<KeyRelease>", self.refresh)
        actions = [("Ban Member", "#f0ad4e", "#ec971f", "Banni",
                    "Êtes-vous sûr de vouloir bannir ce membre ?", "Le membre a été banni avec succès."),
                   ("Reactivate Member", "#5cb85c", "#449d44", "Actif",
                    "Voulez-vous réactiver ce membre ?", "Le membre a été réactivé avec succès.")]
        for col, (text, color, hover, *args) in enumerate(actions, start=1):
            ctk.CTkButton(bar, text=text, fg_color=color, hover_color=hover,
                          command=lambda a=args: self.set_status(*a)).grid(row=0, column=col, padx=5)
 
        # Tableau
        frame = ctk.CTkFrame(page)
        frame.grid(row=1, column=0, sticky="nsew")
        frame.grid_columnconfigure(0, weight=1)
        frame.grid_rowconfigure(0, weight=1)
        dark = ctk.get_appearance_mode() == "Dark"
        bg = "#333333" if dark else "#FFFFFF"
        style = ttk.Style()
        style.theme_use("default")
        style.configure("Treeview", background=bg, fieldbackground=bg, rowheight=25,
                        foreground="white" if dark else "black", borderwidth=0)
        style.configure("Treeview.Heading", background="#1f538d", foreground="white",
                        relief="flat", font=("Segoe UI", 10, "bold"))
        style.map("Treeview", background=[("selected", "#1f538d")], foreground=[("selected", "white")])
 
        self.tree = ttk.Treeview(frame, columns=[c[0] for c in COLS], show="headings")
        for key, text, width, anchor in COLS:
            self.tree.heading(key, text=text)
            self.tree.column(key, width=width, anchor=anchor)
        self.tree.tag_configure("banni", foreground="#da251f")
        self.tree.grid(row=0, column=0, sticky="nsew", padx=(10, 0), pady=10)
        sb = ctk.CTkScrollbar(frame, command=self.tree.yview)
        self.tree.configure(yscrollcommand=sb.set)
        sb.grid(row=0, column=1, sticky="ns", pady=10, padx=(0, 5))
 
    # --- Logique ---
    def show_page(self, name):
        for n, b in self.nav.items():
            b.configure(fg_color=("gray70", "gray30") if n == name else "transparent")
        if name == "Members":
            self.members_page.tkraise()
        else:
            self.other_label.configure(text=f"Page « {name} » : à venir")
            self.other_page.tkraise()
 
    def refresh(self, event=None):
        """Remplit le tableau (avec filtre de recherche) et met à jour les compteurs."""
        query = self.search.get().lower().strip()
        members = db.get_all_members()
        self.tree.delete(*self.tree.get_children())
        for m in members:
            if query in m["name"].lower() or query in m["email"].lower():
                self.tree.insert("", "end", values=(m["id"], m["name"], m["email"], m["status"]),
                                 tags=("banni",) if m["status"] == "Banni" else ())
        self.kpi[0].configure(text=str(len(members)))
        self.kpi[1].configure(text=str(sum(m["status"] == "Actif" for m in members)))
 
    def set_status(self, status, question, success):
        sel = self.tree.selection()
        if not sel:
            return messagebox.showwarning("Sélection requise",
                                          "Veuillez sélectionner un membre dans le tableau.")
        if messagebox.askyesno("Confirmer", question):
            db.update_member_status(int(self.tree.item(sel[0])["values"][0]), status)
            self.refresh()
            messagebox.showinfo("Succès", success)
 
    def logout(self):
        self.logged_out = True
        self.destroy()
 
 
if __name__ == "__main__":
    AdminDashboard().mainloop()
 